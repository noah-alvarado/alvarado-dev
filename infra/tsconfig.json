{
  "extends": "@tsconfig/node26/tsconfig.json",
  "compilerOptions": {
    // Node runs bin/app.ts directly (type-stripping), so tsc is a typecheck only
    // and relative imports carry .ts extensions.
    "noEmit": true,
    "allowImportingTsExtensions": true,
    // aws-cdk-lib construct props are assigned after super(), not in the field.
    "strict": true,
    "strictPropertyInitialization": false,
    "noImplicitReturns": true,
    "experimentalDecorators": true,
    "resolveJsonModule": true,
    // Since TS 6 a bare typeRoots no longer auto-includes @types/node; keep it
    // explicit or process/import.meta/Disposable break.
    "typeRoots": ["./node_modules/@types"],
    "types": ["node"]
  },
  "include": ["bin/**/*.ts", "lib/**/*.ts"],
  "exclude": ["node_modules", "cdk.out"]
}
