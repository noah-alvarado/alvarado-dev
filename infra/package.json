{
  "name": "alvarado-dev-infra",
  "version": "1.0.0",
  "private": true,
  "description": "AWS CDK app for alvarado.dev hosting (S3 + CloudFront + Route 53)",
  "bin": { "app": "bin/app.js" },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "synth": "cdk synth",
    "diff": "cdk diff",
    "deploy:dns": "cdk deploy DnsStack",
    "deploy:site": "cdk deploy SiteStack",
    "deploy:all": "cdk deploy --all"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "aws-cdk": "^2.170.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.170.0",
    "constructs": "^10.3.0"
  }
}
