{
  "name": "alvarado-dev-infra",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AWS CDK app for alvarado.dev hosting (S3 + CloudFront + Route 53)",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "synth": "cdk synth",
    "diff": "cdk diff",
    "deploy:dns": "cdk deploy DnsStack",
    "deploy:site": "cdk deploy SiteStack",
    "deploy:all": "cdk deploy --all"
  },
  "devDependencies": {
    "@tsconfig/node26": "^26.0.0",
    "@types/node": "^26.2.0",
    "aws-cdk": "^2.1135.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.264.0",
    "constructs": "^10.3.0"
  }
}
